{
  "manifest_version": 3,
  "name": "SecureVault Autofill",
  "version": "1.0.0",
  "description": "Fill, suggest, save and update passwords from your local SecureVault. No cloud - talks only to the SecureVault app on this machine.",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "SecureVault Autofill",
    "default_popup": "popup.html"
  },
  "icons": {}
}